# Clerk (https://clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# PostgreSQL - Neon (https://neon.tech)
DATABASE_URL=postgresql://user:password@your-neon-hostname/flowforge?sslmode=require

# Google Gemini (https://aistudio.google.com)
GEMINI_API_KEY=AIzaSy...

# Admin secret for running migrations
ADMIN_SECRET=pick-a-random-string

# Trigger.dev (https://trigger.dev)
TRIGGER_SECRET_KEY=tr_dev_your_trigger_secret_key
TRIGGER_PROJECT_ID=proj_your_project_id

# Execution backend for Gemini / Crop Image nodes — must be "direct" or "trigger".
# "direct": run tasks in this process (used automatically in development if unset).
# "trigger": submit to Trigger.dev; failures are reported, never silently
#            retried through the direct executor. Required to be set
#            explicitly in production — there is no implicit default there.
EXECUTION_MODE=direct
